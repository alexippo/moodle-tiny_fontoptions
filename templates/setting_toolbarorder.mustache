{{!
    @template tiny_fontoptions/setting_toolbarorder

    Toolbar order setting: the text area, the default order and the buttons in the editor,
    which amd/src/toolbarorder.js reads from a hidden editor.

    Context variables required for this template:
    * cols, rows, id, name, value, forceltr, readonly - as for core_admin/setting_configtextarea
    * previewid - id of the block with the default order; the hidden editor gets this id with "_editor"
    * settingsurl - the plugin settings page, linked to where the hidden editor cannot be loaded

    Example context (json):
    {
        "cols": "60",
        "rows": "12",
        "id": "id_s_tiny_fontoptions_toolbarorder",
        "name": "s_tiny_fontoptions_toolbarorder",
        "value": "undo redo\nbold italic\n*",
        "forceltr": true,
        "readonly": false,
        "previewid": "id_s_tiny_fontoptions_toolbarorder_preview",
        "settingsurl": "https://example.com/admin/settings.php?section=tiny_fontoptions_settings"
    }
}}
{{> core_admin/setting_configtextarea }}
<div id="{{previewid}}" class="tiny-fontoptions-toolbarorder mt-2">
    <div class="alert alert-warning" data-region="unknown" hidden></div>
    <div class="mb-2" data-region="noeditor" hidden>
        {{#str}} toolbarorder_noeditor, tiny_fontoptions {{/str}}
        <a href="{{settingsurl}}">{{#str}} settings, tiny_fontoptions {{/str}}</a>
    </div>
    <div data-region="default">
        <div class="mb-1">{{#str}} toolbarorder_default, tiny_fontoptions {{/str}}</div>
        <pre class="border rounded p-2 mb-2" dir="ltr" data-region="order">{{#str}} toolbarorder_loading, tiny_fontoptions {{/str}}</pre>
        <button type="button" class="btn btn-secondary" data-action="copy" disabled>
            {{#str}} toolbarorder_copy, tiny_fontoptions {{/str}}
        </button>
        <details class="mt-2">
            <summary>{{#str}} toolbarorder_buttons, tiny_fontoptions {{/str}}</summary>
            <p class="mt-1 mb-2">{{#str}} toolbarorder_buttons_desc, tiny_fontoptions {{/str}}</p>
            <div>{{#str}} toolbarorder_buttonsdefault, tiny_fontoptions {{/str}}</div>
            <ul class="list-unstyled mb-2" dir="ltr" data-region="buttons"></ul>
            <div>{{#str}} toolbarorder_buttonsother, tiny_fontoptions {{/str}}</div>
            <ul class="list-unstyled mb-0" dir="ltr" data-region="otherbuttons"></ul>
        </details>
    </div>
    <div class="d-none" aria-hidden="true">
        <textarea id="{{previewid}}_editor" rows="3"></textarea>
    </div>
</div>
